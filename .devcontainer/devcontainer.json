{
  "name": "Sports ML Lab · private preview",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {"ghcr.io/devcontainers/features/github-cli:1": {}},
  "containerEnv": {
    "SPORTSLAB_HOME": "${containerWorkspaceFolder}/runtime",
    "SPORTSLAB_VENV": "${containerWorkspaceFolder}/.venv",
    "SPORTSLAB_BIND": "0.0.0.0",
    "SPORTSLAB_DEV_PREVIEW": "1",
    "PORT": "8765"
  },
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Sports ML Lab (private, sign-in required)",
      "onAutoForward": "openBrowser",
      "protocol": "http",
      "requireLocalPort": true
    }
  },
  "postCreateCommand": "bash scripts/install.sh",
  "postStartCommand": "bash scripts/codespaces-start.sh",
  "customizations": {
    "codespaces": {"openFiles": ["docs/PREVIEW.md"]},
    "vscode": {"extensions": ["ms-python.python"]}
  }
}
